# E2E тестирование через Telethon
# Скопируй в .env.e2e и заполни

# Telegram API — используй тестовые credentials
# Тестовый сервер: api_id=94575, api_hash=a3406de8d171bb422bb6ddf3bbd800e2
# ИЛИ создай свои на https://my.telegram.org
TELEGRAM_API_ID=94575
TELEGRAM_API_HASH=a3406de8d171bb422bb6ddf3bbd800e2

# StringSession (сгенерировать через scripts/generate_telethon_session.py)
# После первого запуска скрипта вставь сюда полученный StringSession
TELETHON_SESSION=""

# Бот для тестирования
BOT_USERNAME=training_dag_run_bot

# Garmin тестовые credentials
GARMIN_TEST_EMAIL=bootchq@gmail.com
GARMIN_TEST_PASSWORD=Aa1424617556

# Таймауты (секунды)
E2E_TIMEOUT=30
E2E_MESSAGE_WAIT=5
